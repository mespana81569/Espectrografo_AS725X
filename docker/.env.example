# ─── MySQL ──────────────────────────────────────────────────────────────────
# Both MUST be the same string — Flask reads MYSQL_PASSWORD, the MySQL image
# initialises the root account from MYSQL_ROOT_PASSWORD.  Drift = silent
# breakage.  Changing either AFTER the mysql_data volume is initialised has
# no effect; use `docker compose down -v` to re-init from init.sql.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_DATABASE=espectrografo

# ─── MQTT broker (mosquitto, anonymous = false) ────────────────────────────
# Username/password are also persisted into docker/mosquitto/passwd via
# `mosquitto_passwd`.  The two must agree — generate the file once with:
#   docker run --rm -it -v $(pwd)/docker/mosquitto:/mosquitto/config \
#     eclipse-mosquitto:2.0 mosquitto_passwd -c /mosquitto/config/passwd <user>
# Read by: mqtt_to_db.py (server side) and the ESP32 firmware
# (firmware/src/mqtt/mqtt_credentials.h — gitignored, edit there too).
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ─── Dashboard session login (Flask) ───────────────────────────────────────
# Set FLASK_SECRET_KEY to a long random hex string — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Rotating this key invalidates every issued session cookie (forces re-login).
# It does NOT need to match anything else on the system.
FLASK_SECRET_KEY=

# Single-user credentials for the dashboard.  Plain string compared with
# secrets.compare_digest in app.py — store a strong password.
LOGIN_USERNAME=
LOGIN_PASSWORD=

# Hours a session cookie stays valid after sign-in.  After this elapses, the
# next API call returns 401 and the dashboard redirects to /login.
SESSION_HOURS=12

# Set to 1 once the stack sits behind HTTPS — stops the cookie from ever
# being sent over plain HTTP.  Leave at 0 for HTTP-only dev/internal hosts.
SESSION_COOKIE_SECURE=0

# ─── Browser → broker (websockets) ─────────────────────────────────────────
# control.html is templated at /serve_html with these values, so it does not
# hardcode "localhost".  MQTT_PUBLIC_HOST is what the BROWSER sees — usually
# the public domain or IP of the server (NOT "mosquitto", which only resolves
# inside the docker network).
MQTT_PUBLIC_HOST=
MQTT_PUBLIC_WS_PORT=9001

# ─── ESP32 → /verify token ─────────────────────────────────────────────────
# Used only by the GET /verify endpoint (the dashboard uses session auth).
# The same value must be flashed into the firmware as FLASK_API_KEY in
# firmware/src/mqtt/mqtt_credentials.h.  Treat as a device secret — once
# split into a dedicated DEVICE_VERIFY_TOKEN you can rotate it without
# touching the dashboard login.
API_KEY=
