#pragma once
// ─── ESP32 secrets template ─────────────────────────────────────────────────
// The real file is gitignored as `firmware/secrets.h` (included from
// mqtt_client.h, main.cpp and sd_logger.cpp via "../secrets.h").
//
// Copy this to `firmware/secrets.h` and fill in real values for your deploy.
// Do NOT commit the real file — gitignore already covers `firmware/secrets.h`.
//
// HOST: shared by MQTT broker (port 1883) and Flask /verify (port 5000).
//       Use the PUBLIC IP / domain of the docker host — same value the
//       browser uses for the dashboard.
// MQTT_USERNAME / MQTT_PASSWORD: must match the entry registered in
//       docker/mosquitto/passwd (created with `mosquitto_passwd -c`).
// FLASK_API_KEY: must match the API_KEY env var in docker/.env.

#define HOST              "IP_O_DOMINIO"          // 0.0.0.0 means "not set"
#define DB_VERIFY_PORT    5000
#define MQTT_USERNAME     "usuario_mqtt"
#define MQTT_PASSWORD     "password_mqtt"
#define FLASK_API_KEY     "token_para_verify"      // 64-char hex recommended
