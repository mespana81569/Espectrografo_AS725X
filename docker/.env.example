# ─── Sample env file ────────────────────────────────────────────────────────
# Copy to docker/.env and fill in REAL values.  docker/.env is gitignored.
# Do not commit secrets here — keep this file with placeholders only.

# ─── MySQL ──────────────────────────────────────────────────────────────────
# MYSQL_USER + MYSQL_PASSWORD: the mysql:8.4 image auto-creates this account
# on first init (privileges scoped to MYSQL_DATABASE).  Flask and the bridge
# both connect with it — root-from-any-host is refused by MySQL 8's default
# ACL, so don't set MYSQL_USER=root here.
MYSQL_ROOT_PASSWORD=
MYSQL_USER=espectrografo_user
MYSQL_PASSWORD=
MYSQL_DATABASE=espectrografo

# ─── MQTT (server-side) ─────────────────────────────────────────────────────
# These are how Flask + the bridge talk to mosquitto INSIDE the docker
# network.  Don't change MQTT_BROKER unless you rename the mosquitto service.
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ─── ESP32 → /verify token ──────────────────────────────────────────────────
# 64-char hex (use:  python -c "import secrets; print(secrets.token_hex(32))")
# Must match FLASK_API_KEY in firmware/secrets.h.
API_KEY=

# ─── Dashboard session login ────────────────────────────────────────────────
# 64-char hex (use:  python -c "import secrets; print(secrets.token_hex(32))")
# A missing/empty key makes Flask refuse to start (fail loud, not silent).
FLASK_SECRET_KEY=
LOGIN_USERNAME=
LOGIN_PASSWORD=
SESSION_HOURS=12
# Set to 1 only when serving the dashboard over HTTPS — otherwise the cookie
# would never be sent and login appears to "work" then drop the session.
SESSION_COOKIE_SECURE=0

# ─── Browser-facing broker (WebSockets) ─────────────────────────────────────
# control.html is templated at request time with these values.  MQTT_PUBLIC_HOST
# must be the PUBLIC IP/domain the BROWSER will use — NOT "mosquitto", which
# only resolves inside the docker network.
MQTT_PUBLIC_HOST=
MQTT_PUBLIC_WS_PORT=9001
